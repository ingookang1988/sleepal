# Firebase Console > Project settings > General > Your apps > App ID
FIREBASE_APP_ID=1:000000000000:android:0000000000000000000000

# Optional. The project default is also pinned in .firebaserc.
FIREBASE_PROJECT_ID=sleepal-app

# Set one or both. Group values are Firebase App Distribution group aliases.
FIREBASE_TESTER_GROUPS=sleepal-testers
# FIREBASE_TESTERS=tester@example.com

# Optional release note shown to testers.
FIREBASE_RELEASE_NOTES=SleepPal Android preview
